{
  "manifest_version": 3,
  "name": "InSync",
  "author": "Nicolas BOGALHEIRO",
  "version": "1.0.0",
  "description": "Analyse LinkedIn profile (https://www.linkedin.com/in/*) and detect inconsistencies",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
	"default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}